 "candidatos": [
  {
   "id": 250002536394,
   "numero": 22077,
   "nomeUrna": "DANILO MORGADO",
   "partido": "PL",
   "motivos": [
    {
     "tipo": "justica",
     "texto": "Foi preso em 17/09/2026 na Operação Vectura Corrupta, da Polícia Civil e do Ministério Público de São Paulo, que investiga a infiltração do PCC no transporte público da capital. A decisão judicial cita indícios de ligação dele com a organização e de financiamento da sua campanha a prefeito de Praia Grande em 2024 por integrantes dela. Em 23/09/2026 o STJ não aceitou o pedido de habeas corpus, sem analisar se a prisão é legal. A defesa diz que a prisão é ilegal.",
     "status": "preso",
     "fonte": "https://metropoles.com/sao-paulo/stj-habeas-corpus-danilo-morgado",
     "fonte_nome": "Metrópoles",
     "data_fonte": "2026-09-23",
     "fontes_extra": [
      "https://sbtnews.sbt.com.br/noticia/brasil/danilo-morgado-e-preso-em-operacao-relacionada-ao-pcc-em-sp"
     ]
    }
   ]
  },
  {
   "id": 250002536410,
   "numero": 22500,
   "nomeUrna": "LUCAS BOVE",
   "partido": "PL",
   "motivos": [
    {
     "tipo": "justica",
     "texto": "É réu na Justiça de São Paulo por violência doméstica contra a ex-mulher, a influenciadora Cíntia Chagas. Em setembro de 2025 a Polícia Civil o indiciou por violência psicológica e perseguição. Ele nega as acusações. A informação mais recente encontrada é de maio de 2026; não foi encontrada notícia de julgamento.",
     "status": "réu",
     "fonte": "https://www.metropoles.com/sao-paulo/alesp-pedidos-cassacao-bove",
     "fonte_nome": "Metrópoles",
     "data_fonte": "2026-05-14",
     "fontes_extra": [
      "https://www.congressoemfoco.com.br/noticia/112518/deputado-lucas-bove-e-indiciado-por-violencia-contra-cintia-chagas"
     ]
    },
    {
     "tipo": "justica",
     "texto": "O Conselho de Ética da ALESP arquivou, em agosto de 2025, o pedido de cassação do mandato ligado ao caso da ex-mulher. Em maio de 2026, rejeitou por 5 votos a 2 uma suspensão de 30 dias proposta por ofensas a deputadas em sessões da Casa; ficou pendente a análise de uma punição mais leve, cujo resultado não foi encontrado.",
     "status": "arquivado",
     "fonte": "https://www.metropoles.com/sao-paulo/alesp-pedidos-cassacao-bove",
     "fonte_nome": "Metrópoles",
     "data_fonte": "2026-05-14",
     "fontes_extra": [
      "https://www.congressoemfoco.com.br/noticia/112518/deputado-lucas-bove-e-indiciado-por-violencia-contra-cintia-chagas"
     ]
    }
   ]
  },
  {
   "id": 250002533776,
   "numero": 11777,
   "nomeUrna": "DELEGADO OLIM",
   "partido": "PP",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "Foi citado na delação do empresário Vinicius Gritzbach, que relatou cobrança de propina por policiais civis. A investigação contra ele foi arquivada pelo Ministério Público de São Paulo em 2025: a Procuradoria-Geral de Justiça concluiu que não havia provas de corrupção.",
     "status": "arquivado",
     "fonte": "https://g1.globo.com/sp/sao-paulo/noticia/2025/04/03/mp-arquiva-investigacao-contra-deputado-delegados-e-advogado-delatados-por-gritzbach-suspeitos-de-cobrar-r-5-milhoes-em-propina.ghtml",
     "fonte_nome": "G1",
     "data_fonte": "2025-04-03"
    }
   ]
  },
  {
   "id": 250002534178,
   "numero": 25000,
   "nomeUrna": "ATILA JACOMUSSI",
   "partido": "PRD",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "É réu em ação penal da Operação Prato Feito (2018), que apurou fraude em licitação de uniformes escolares e corrupção quando ele era prefeito de Mauá. Foi preso duas vezes em 2018 e denunciado pelo Ministério Público Federal em 2019. Em março de 2026 o TRE-SP negou o pedido para suspender a ação, que continua sem julgamento. Ele nega as acusações.",
     "status": "réu",
     "fonte": "https://www.dgabc.com.br/Noticia/4290173/justica-mantem-atila-sob-mira-de-acao-da-operacao-prato-feito",
     "fonte_nome": "Diário do Grande ABC",
     "data_fonte": "2026-03-15",
     "fontes_extra": [
      "https://g1.globo.com/sp/sao-paulo/noticia/2019/01/30/mpf-denuncia-prefeito-de-maua-e-outras-nove-pessoas-por-fraude-em-licitacao-e-corrupcao.ghtml"
     ]
    },
    {
     "tipo": "corrupcao",
     "texto": "As contas dos quatro anos em que foi prefeito de Mauá (2017 a 2020) tiveram parecer contrário do Tribunal de Contas do Estado e foram rejeitadas pela Câmara Municipal. Em abril de 2026 o Tribunal de Justiça negou o pedido dele para anular a rejeição. Mesmo assim, o TRE-SP aprovou o registro da candidatura em 10/09/2026, por 5 votos a 0.",
     "status": "contas irregulares",
     "fonte": "https://www.dgabc.com.br/Noticia/4294933/justica-mantem-rejeicao-as-contas-de-atila-e-volpi-que-negam-implicacoes-eleitorais",
     "fonte_nome": "Diário do Grande ABC",
     "data_fonte": "2026-04-16",
     "fontes_extra": [
      "https://www.dgabc.com.br/Noticia/4346249/atila-tem-registro-de-candidatura-deferido-pelo-tre-sp"
     ]
    }
   ]
  },
  {
   "id": 250002540915,
   "numero": 55088,
   "nomeUrna": "CLOVIS VOLPI",
   "partido": "PSD",
   "motivos": [
    {
     "tipo": "justica",
     "texto": "Foi cassado do cargo de prefeito de Ribeirão Pires em setembro de 2022: o TSE confirmou, por unanimidade, que ele estava inelegível pela Lei da Ficha Limpa na eleição de 2020, por ter as contas de 2012 rejeitadas pelo Tribunal de Contas do Estado.",
     "status": "cassado",
     "fonte": "https://www.dgabc.com.br/Noticia/3884962/tse-aprova-cassacao-do-prefeito-clovis-volpi-em-ribeirao-pires",
     "fonte_nome": "Diário do Grande ABC",
     "data_fonte": "2022-09-13"
    },
    {
     "tipo": "corrupcao",
     "texto": "Foi condenado em 1ª instância por improbidade administrativa em 2020 (gastos e contratações no fim do mandato de 2012). Em agosto de 2023 o Tribunal de Justiça de São Paulo reformou a sentença e o absolveu.",
     "status": "absolvido",
     "fonte": "https://www.dgabc.com.br/Noticia/4028918/justica-reve-condenacao-e-absolve-volpi-em-processo-que-resultou-em-cassacao",
     "fonte_nome": "Diário do Grande ABC",
     "data_fonte": "2023-08-16"
    },
    {
     "tipo": "corrupcao",
     "texto": "Em decisão noticiada em abril de 2026, o STF negou recurso dele e manteve a rejeição das contas de 2012 da Prefeitura de Ribeirão Pires. A defesa diz que isso não o impede de concorrer. No TSE, o registro da candidatura de 2026 aparece como \"deferido com recurso\" (aprovado, mas ainda contestado).",
     "status": "contas irregulares",
     "fonte": "https://www.dgabc.com.br/Noticia/4294933/justica-mantem-rejeicao-as-contas-de-atila-e-volpi-que-negam-implicacoes-eleitorais",
     "fonte_nome": "Diário do Grande ABC",
     "data_fonte": "2026-04-16"
    }
   ]
  },
  {
   "id": 250002540887,
   "numero": 55456,
   "nomeUrna": "DIRCEU DALBEN",
   "partido": "PSD",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "Tem três condenações por improbidade administrativa da época em que foi prefeito de Sumaré (contratações de construtoras consideradas irregulares). Por causa delas o TRE-SP barrou sua candidatura em 2022, mas o TSE liberou o registro em dezembro de 2022: entendeu que os processos ainda estavam em andamento e que as condenações não o tornavam inelegível. Não foi encontrada informação sobre o desfecho dos processos.",
     "status": "condenado",
     "fonte": "https://www.gazetasp.com.br/cotidiano/justica-aprova-registro-de-dalben-e-fara-recontagem-para-considera-lo/",
     "fonte_nome": "Gazeta de S.Paulo",
     "data_fonte": "2022-12-08"
    }
   ]
  },
  {
   "id": 250002540875,
   "numero": 55125,
   "nomeUrna": "MAURO BRAGATO",
   "partido": "PSD",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "Perdeu o mandato de deputado em julho de 2016 por causa de uma condenação definitiva por improbidade administrativa (compra de leite com preço acima do mercado quando era prefeito de Presidente Prudente, em 1999 e 2000). Depois, a 2ª Turma do STJ aceitou ação rescisória, anulou a condenação e julgou improcedente a ação de improbidade.",
     "status": "anulado",
     "fonte": "https://www.sedep.com.br/?p=102162",
     "fonte_nome": "STJ (notícia reproduzida pelo portal SEDEP)",
     "data_fonte": null,
     "fontes_extra": [
      "http://g1.globo.com/sp/presidente-prudente-regiao/noticia/2016/07/alesp-acata-determinacao-da-justica-e-cassa-deputado-mauro-bragato.html"
     ]
    }
   ]
  },
  {
   "id": 250002540880,
   "numero": 55555,
   "nomeUrna": "ROGERIO NOGUEIRA",
   "partido": "PSD",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "É réu desde abril de 2023 em ação penal no Tribunal de Justiça de São Paulo por peculato, lavagem de dinheiro e organização criminosa. O Ministério Público o acusa de comandar um esquema de \"rachadinha\" (devolução de parte do salário de assessores) no gabinete. Ele nega. Não foi encontrada notícia de julgamento até setembro de 2026.",
     "status": "réu",
     "fonte": "https://g1.globo.com/sp/sao-paulo/sp2/noticia/2023/04/28/justica-de-sp-aceita-denuncia-contra-deputado-rogerio-nogueira-do-psdb-por-esquema-de-rachadinha.ghtml",
     "fonte_nome": "G1",
     "data_fonte": "2023-04-28"
    }
   ]
  },
  {
   "id": 250002536846,
   "numero": 13700,
   "nomeUrna": "DONATO",
   "partido": "PT",
   "motivos": [
    {
     "tipo": "corrupcao",
     "texto": "Foi investigado pelo Ministério Público de São Paulo por suspeita de improbidade e enriquecimento ilícito depois de ser citado no caso da \"Máfia do ISS\" (2013), quando era vereador. O inquérito foi arquivado em julho de 2016: o promotor afirmou que não encontrou irregularidades nas contas dele. Não chegou a ser investigado na esfera criminal.",
     "status": "arquivado",
     "fonte": "https://www.metropoles.com/brasil/politica-brasil/mpe-arquiva-acao-contra-vereador-do-pt-na-mafia-do-iss",
